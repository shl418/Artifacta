# Public app URL used to generate preview and API links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Change this in every shared or production deployment.
AUTH_SECRET=replace-with-a-long-random-secret

# Metadata storage. Use DATA_DRIVER=sqlite for the production-like local adapter.
DATA_DRIVER=json
DATA_DIR=.artifacta
SQLITE_PATH=.artifacta/artifacta.sqlite

# Uploaded dashboard and dataset artifacts.
UPLOAD_DIR=.artifacta/uploads
