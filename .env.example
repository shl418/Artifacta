# Public app URL used to generate preview and API links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Change this in every shared or production deployment.
AUTH_SECRET=replace-with-a-long-random-secret

# Metadata storage. Use DATA_DRIVER=sqlite for single-node self-hosting or
# DATA_DRIVER=postgres for multi-instance metadata.
DATA_DRIVER=json
DATA_DIR=.artifacta
SQLITE_PATH=.artifacta/artifacta.sqlite
POSTGRES_URL=

# Uploaded dashboard and dataset artifacts. Use STORAGE_DRIVER=s3 for S3/COS/R2/MinIO.
STORAGE_DRIVER=local
UPLOAD_DIR=.artifacta/uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Upload and rate-limit controls.
ARTIFACTA_MAX_ARTIFACT_BYTES=104857600
ARTIFACTA_MAX_DATASET_BYTES=52428800
ARTIFACTA_MAX_REQUEST_BYTES=131072000
ARTIFACTA_RATE_LIMIT_WINDOW_MS=60000
ARTIFACTA_RATE_LIMIT_MAX=120
ARTIFACTA_API_KEY_EXPIRY_DAYS=90

# Optional OIDC login.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Comma-separated host allowlist for dataset sync URL sources.
# Leave empty to disable remote URL sync in shared deployments.
SYNC_URL_ALLOWLIST=

# Base directory for local file sync sources.
# Paths outside this directory are rejected. Leave empty to allow any local path (dev only).
SYNC_LOCAL_BASE_DIR=
